						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "SqlServerSource",
								"sqlReaderQuery": "SELECT last_watermark\nFROM pipeline_watermark\nWHERE pipeline_name='geofence_alert_pipeline'",
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "ds_sql_query",
								"type": "DatasetReference",
								"parameters": {}
